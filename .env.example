# Secret for POST /api/revalidate, which pushes a Notion edit live immediately
# instead of waiting for the ISR window. Generate any long random string.
REVALIDATE_SECRET=

# Not used by the renderer. The site reads Notion's public API, which needs no
# credentials for the public docs tree. This is only for scripts/notion_export.py,
# kept as reference material.
# NOTION_API_SECRET=
